# =============================================================================
#  NEXUS AI — PRODUCTION GITIGNORE
#  Architected for Python, PyQt6, Playwright, PyInstaller & Inno Setup
# =============================================================================

# ── 1. Executables & Installers (Uploaded to GitHub Releases) ────────────────
# Precompiled setups must NEVER be stored in git history.
# Download binaries directly from: https://github.com/Duckierpine3108/Nexus-AI/releases
*.exe
*.msi
*.dll
*.so
*.dylib

# ── 2. PyInstaller & Build Output Directories ────────────────────────────────
build/
dist/
Output/
*.manifest
*.spec.bak
# Ignore auto-generated spec files, but preserve the primary production spec:
*.spec
!nexus_ai.spec

# ── 3. Python Bytecode, C-Extensions & Caches ─────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
.pytest_cache/
.mypy_cache/

# ── 4. Virtual Environments & Package Managers ──────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── 5. Sensitive Credentials, Secrets & Certificates ─────────────────────────
# Keep private API keys and SSL keys strictly on local machines!
.env
*.env
.env.*
api_keys.json
config/api_keys.json
config/certs/*.key
config/certs/*.pem
jarvis.key
jarvis.crt

# ── 6. Local User State, Biometrics & Hardware Telemetry ──────────────────────
# Prevents overwriting individual workstation runtime state and user voiceprints:
config/devices_telemetry.json
config/evolution_session.json
config/last_splash.json
config/splash_session.lock
config/user_voiceprint.npy

# ── 7. Long-Term Memory & Local Databases ────────────────────────────────────
# User workout records (pushup PRs), agent chat logs, and vector memory:
memory/long_term.json
*.db
*.sqlite
*.sqlite3

# ── 8. System Diagnostics, Trees & Runtime Logs ──────────────────────────────
*.log
nexus_tree.txt
nexus_structure.txt
*.tmp
*.bak

# ── 9. Playwright & Browser Artifacts ────────────────────────────────────────
playwright-report/
test-results/
.playwright/

# ── 10. Operating System & Code Editor Metadata ──────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store